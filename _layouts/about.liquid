---
layout: default
---
<article class="portfolio-home">
  <header class="portfolio-intro">
    <div>
      <p class="portfolio-eyebrow">Research &amp; teaching</p>
      <h1>{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="portfolio-position">{{ page.subtitle }}</p>
    </div>
    {% if page.profile.image %}
      <div class="portfolio-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path sizes="120px" alt="Portrait of Kamal Mandava" cache_bust=true %}
      </div>
    {% endif %}
  </header>
  <div class="portfolio-content">{{ content }}</div>
  <section class="portfolio-contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Get in touch</h2>
    <p>Find me on <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>, explore my <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>, or read my <a href="{{ '/cv/' | relative_url }}">CV</a>.</p>
  </section>
</article>
